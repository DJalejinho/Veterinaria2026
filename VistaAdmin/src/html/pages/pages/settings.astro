---
import Head from "@components/_head.astro"
import Footer from "@components/dashboard/_footer.astro"
import Topbar from "@components/dashboard/_topbar.astro"
import Sidenav from "@components/dashboard/_sidenav.astro"
import Scripts from "@components/_scripts.astro"

const title = "AdminLTE 4 | Configuración"
const path = "../../../dist"
const mainPage = "pages"
const page = "settings";
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <Head title={title} path={path} />
  </head>
  <body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <div class="app-wrapper">
      <Topbar path={path} />
      <Sidenav path={path} mainPage={mainPage} page={page} />
      <main class="app-main">
        <div class="app-content-header">
          <div class="container-fluid">
            <div class="row">
              <div class="col-sm-6">
                <h1 class="mb-0 fs-3">Configuración</h1>
              </div>
              <div class="col-sm-6">
                <nav aria-label="breadcrumb">
                  <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="#">Inicio</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Configuración</li>
                  </ol>
                </nav>
              </div>
            </div>
          </div>
        </div>
        <div class="app-content">
          <div class="container-fluid">
            <div class="row g-3">
              <!-- Left rail -->
              <div class="col-md-3">
                <div
                  class="list-group list-group-flush nav nav-pills flex-column"
                  id="settings-nav"
                  role="tablist"
                >
                  <a
                    href="#account"
                    class="list-group-item list-group-item-action active"
                    data-bs-toggle="pill"
                    role="tab"
                    aria-selected="true"
                  >
                    <i class="bi bi-person me-2" aria-hidden="true"></i>Cuenta
                  </a>
                  <a
                    href="#notifications"
                    class="list-group-item list-group-item-action"
                    data-bs-toggle="pill"
                    role="tab"
                  >
                    <i class="bi bi-bell me-2" aria-hidden="true"></i>Notificaciones
                  </a>
                  <a
                    href="#security"
                    class="list-group-item list-group-item-action"
                    data-bs-toggle="pill"
                    role="tab"
                  >
                    <i class="bi bi-shield-lock me-2" aria-hidden="true"></i>Security
                  </a>
                  <a
                    href="#billing"
                    class="list-group-item list-group-item-action"
                    data-bs-toggle="pill"
                    role="tab"
                  >
                    <i class="bi bi-credit-card me-2" aria-hidden="true"></i>Billing
                  </a>
                  <a
                    href="#danger"
                    class="list-group-item list-group-item-action text-danger"
                    data-bs-toggle="pill"
                    role="tab"
                  >
                    <i
                      class="bi bi-exclamation-triangle me-2"
                      aria-hidden="true"
                    ></i>
                    Zona de peligro
                  </a>
                </div>
              </div>

              <!-- Tab content -->
              <div class="col-md-9">
                <div class="tab-content">
                  <!-- Cuenta -->
                  <div
                    class="tab-pane fade show active"
                    id="account"
                    role="tabpanel"
                  >
                    <div class="card">
                      <div class="card-header">
                        <h3 class="card-title">Cuenta</h3>
                      </div>
                      <div class="card-body">
                        <form class="row g-3">
                          <div class="col-md-6">
                            <label class="form-label" for="settings-name">
                              Nombre completo
                            </label>
                            <input
                              type="text"
                              class="form-control"
                              id="settings-name"
                              value="Jane Doe"
                            />
                          </div>
                          <div class="col-md-6">
                            <label class="form-label" for="settings-email">
                              Correo electrónico
                            </label>
                            <input
                              type="email"
                              class="form-control"
                              id="settings-email"
                              value="jane@example.com"
                            />
                          </div>
                          <div class="col-md-6">
                            <label class="form-label" for="settings-tz">
                              Zona horaria
                            </label>
                            <select class="form-select" id="settings-tz">
                              <option>UTC</option>
                              <option selected>America/Los_Angeles</option>
                              <option>Europe/London</option>
                              <option>Asia/Tokyo</option>
                            </select>
                          </div>
                          <div class="col-md-6">
                            <label class="form-label" for="settings-lang">
                              Idioma
                            </label>
                            <select class="form-select" id="settings-lang">
                              <option selected>Español</option>
                              <option>Español</option>
                              <option>Français</option>
                              <option>Deutsch</option>
                            </select>
                          </div>
                          <div class="col-12">
                            <button type="submit" class="btn btn-primary">
                              Guardar cambios
                            </button>
                          </div>
                        </form>
                      </div>
                    </div>
                  </div>

                  <!-- Notificaciones -->
                  <div class="tab-pane fade" id="notifications" role="tabpanel">
                    <div class="card">
                      <div class="card-header">
                        <h3 class="card-title">Notificaciones</h3>
                      </div>
                      <div class="card-body">
                        <p class="text-secondary">
                          Elige sobre qué quieres recibir notificaciones.
                        </p>
                        {
                          [
                            ["Actualizaciones del producto", "Versiones principales y registros de cambios"],
                            ["Alertas de seguridad", "Intentos de inicio de sesión y cambios en la cuenta"],
                            ["Resumen semanal", "Resumen de la actividad en tu espacio de trabajo"],
                            ["Menciones", "Cuando un compañero te mencione con @"]
                          ].map(([label, desc], i) => (
                            <div class="d-flex justify-content-between align-items-start py-2 border-bottom">
                              <div>
                                <p class="mb-0 fw-semibold">{label}</p>
                                <small class="text-secondary">{desc}</small>
                              </div>
                              <div class="form-check form-switch mb-0">
                                <input
                                  class="form-check-input"
                                  type="checkbox"
                                  role="switch"
                                  id={`notif-${i}`}
                                  checked={i < 2}
                                />
                                <label
                                  class="visually-hidden"
                                  for={`notif-${i}`}
                                >
                                  Toggle {label}
                                </label>
                              </div>
                            </div>
                          ))
                        }
                        <button class="btn btn-primary mt-3">Guardar preferencias</button>
                      </div>
                    </div>
                  </div>

                  <!-- Security -->
                  <div class="tab-pane fade" id="security" role="tabpanel">
                    <div class="card">
                      <div class="card-header">
                        <h3 class="card-title">Contraseña</h3>
                      </div>
                      <div class="card-body">
                        <form class="row g-3">
                          <div class="col-md-12">
                            <label class="form-label" for="pwd-current">
                              Contraseña actual
                            </label>
                            <input
                              type="password"
                              class="form-control"
                              id="pwd-current"
                            />
                          </div>
                          <div class="col-md-6">
                            <label class="form-label" for="pwd-new">
                              Nueva contraseña
                            </label>
                            <input type="password" class="form-control" id="pwd-new" />
                          </div>
                          <div class="col-md-6">
                            <label class="form-label" for="pwd-confirm">
                              Confirmar nueva contraseña
                            </label>
                            <input
                              type="password"
                              class="form-control"
                              id="pwd-confirm"
                            />
                          </div>
                          <div class="col-12">
                            <button type="submit" class="btn btn-primary">
                              Actualizar contraseña
                            </button>
                          </div>
                        </form>
                      </div>
                    </div>
                    <div class="card mt-3">
                      <div class="card-header">
                        <h3 class="card-title">Autenticación en dos pasos</h3>
                      </div>
                      <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                          <p class="mb-0 fw-semibold">Aplicación de autenticación</p>
                          <small class="text-secondary">
                            Usa una aplicación de autenticación como 1Password o Authy.
                          </small>
                        </div>
                        <button class="btn btn-outline-primary">Activar</button>
                      </div>
                    </div>
                  </div>

                  <!-- Billing -->
                  <div class="tab-pane fade" id="billing" role="tabpanel">
                    <div class="card">
                      <div class="card-header">
                        <h3 class="card-title">Plan actual</h3>
                      </div>
                      <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                          <div>
                            <p class="mb-0 fw-semibold">Plan Pro</p>
                            <small class="text-secondary">
                              $29 / month &middot; Renews June 18, 2026
                            </small>
                          </div>
                          <a href="#" class="btn btn-outline-primary btn-sm">
                            Cambiar plan
                          </a>
                        </div>
                        <hr />
                        <p class="fw-semibold mb-2">Método de pago</p>
                        <div class="d-flex justify-content-between align-items-center">
                          <div>
                            <i
                              class="bi bi-credit-card-2-front me-2"
                              aria-hidden="true"
                            ></i>
                            Visa terminada en 4242
                          </div>
                          <a href="#" class="btn btn-link btn-sm">Actualizar</a>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Zona de peligro -->
                  <div class="tab-pane fade" id="danger" role="tabpanel">
                    <div class="card border-danger">
                      <div class="card-header bg-danger-subtle">
                        <h3 class="card-title text-danger">Zona de peligro</h3>
                      </div>
                      <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                          <div>
                            <p class="mb-0 fw-semibold">Exportar datos de la cuenta</p>
                            <small class="text-secondary">
                              Descargar una copia de todos tus datos como archivo ZIP.
                            </small>
                          </div>
                          <button class="btn btn-outline-secondary">Exportar</button>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between align-items-start">
                          <div>
                            <p class="mb-0 fw-semibold text-danger">
                              Eliminar cuenta
                            </p>
                            <small class="text-secondary">
                              Esto eliminará permanentemente tu cuenta y todos tus
                              y los datos asociados. Esta acción no se puede deshacer.
                            </small>
                          </div>
                          <button class="btn btn-danger">Eliminar cuenta</button>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </main>
      <Footer />
    </div>
    <Scripts path={path} />
  </body>
</html>
