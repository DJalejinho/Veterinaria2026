---
import Head from "@components/_head.astro"
import Footer from "@components/dashboard/_footer.astro"
import Topbar from "@components/dashboard/_topbar.astro"
import Sidenav from "@components/dashboard/_sidenav.astro"
import Scripts from "@components/_scripts.astro"

const title = "AdminLTE 4 | Perfil de usuario"
const path = "../../../dist"
const mainPage = "pages"
const page = "profile";
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <Head title={title} path={path} />
  </head>
  <body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <div class="app-wrapper">
      <Topbar path={path} />
      <Sidenav path={path} mainPage={mainPage} page={page} />
      <main class="app-main">
        <div class="app-content-header">
          <div class="container-fluid">
            <div class="row">
              <div class="col-sm-6">
                <h1 class="mb-0 fs-3">Perfil de usuario</h1>
              </div>
              <div class="col-sm-6">
                <nav aria-label="breadcrumb">
                  <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="#">Inicio</a></li>
                    <li class="breadcrumb-item"><a href="#">Usuario</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Perfil</li>
                  </ol>
                </nav>
              </div>
            </div>
          </div>
        </div>
        <div class="app-content">
          <div class="container-fluid">
            <div class="row g-3">
              <!-- Perfil sidebar -->
              <div class="col-md-3">
                <!-- Acerca de card -->
                <div class="card">
                  <div class="card-body text-center">
                    <div
                      class="rounded-circle bg-primary-subtle text-primary d-inline-flex align-items-center justify-content-center mb-3"
                      style="width: 96px; height: 96px; font-size: 2rem;"
                      aria-hidden="true"
                    >
                      JD
                    </div>
                    <h3 class="h5 mb-0">Jane Doe</h3>
                    <p class="text-secondary mb-3">Diseñador de producto</p>
                    <ul class="list-group list-group-flush text-start small">
                      <li
                        class="list-group-item d-flex justify-content-between px-0"
                      >
                        <span class="text-secondary">Seguidores</span>
                        <span class="fw-semibold">1,322</span>
                      </li>
                      <li
                        class="list-group-item d-flex justify-content-between px-0"
                      >
                        <span class="text-secondary">Siguiendo</span>
                        <span class="fw-semibold">543</span>
                      </li>
                      <li
                        class="list-group-item d-flex justify-content-between px-0"
                      >
                        <span class="text-secondary">Amigos</span>
                        <span class="fw-semibold">13,287</span>
                      </li>
                    </ul>
                    <a href="#" class="btn btn-primary w-100 mt-3">
                      <i class="bi bi-person-plus me-1" aria-hidden="true"></i>
                      Seguir
                    </a>
                  </div>
                </div>
                <!-- Acerca de details -->
                <div class="card mt-3">
                  <div class="card-header">
                    <h3 class="card-title">Acerca de</h3>
                  </div>
                  <div class="card-body small">
                    <p class="fw-semibold mb-1">
                      <i
                        class="bi bi-mortarboard me-1 text-secondary"
                        aria-hidden="true"
                      ></i>
                      Educación
                    </p>
                    <p class="text-secondary mb-3">
                      Licenciatura en Ciencias de la Computación por la Universidad de Tennessee en
                      Knoxville
                    </p>
                    <p class="fw-semibold mb-1">
                      <i
                        class="bi bi-geo-alt me-1 text-secondary"
                        aria-hidden="true"
                      ></i>
                      Ubicación
                    </p>
                    <p class="text-secondary mb-3">Malibu, California</p>
                    <p class="fw-semibold mb-1">
                      <i
                        class="bi bi-tags me-1 text-secondary"
                        aria-hidden="true"
                      ></i>
                      Habilidades
                    </p>
                    <p class="mb-3">
                      <span class="badge text-bg-secondary me-1">UI/UX</span>
                      <span class="badge text-bg-secondary me-1">Figma</span>
                      <span class="badge text-bg-secondary me-1">Diseño Systems</span>
                      <span class="badge text-bg-secondary">Investigación</span>
                    </p>
                    <p class="fw-semibold mb-1">
                      <i
                        class="bi bi-pencil-square me-1 text-secondary"
                        aria-hidden="true"
                      ></i>
                      Notas
                    </p>
                    <p class="text-secondary mb-0">
                      Lorem ipsum representa una tradición de larga data para los diseñadores,
                      tipógrafos y profesionales afines.
                    </p>
                  </div>
                </div>
              </div>

              <!-- Tabbed content -->
              <div class="col-md-9">
                <div class="card">
                  <div class="card-header p-0 border-bottom-0">
                    <ul
                      class="nav nav-tabs"
                      id="profile-tabs"
                      role="tablist"
                    >
                      <li class="nav-item" role="presentation">
                        <button
                          class="nav-link active"
                          id="activity-tab"
                          data-bs-toggle="tab"
                          data-bs-target="#activity"
                          type="button"
                          role="tab"
                          aria-selected="true"
                        >
                          Actividad
                        </button>
                      </li>
                      <li class="nav-item" role="presentation">
                        <button
                          class="nav-link"
                          id="timeline-tab"
                          data-bs-toggle="tab"
                          data-bs-target="#timeline"
                          type="button"
                          role="tab"
                          aria-selected="false"
                        >
                          Cronología
                        </button>
                      </li>
                      <li class="nav-item" role="presentation">
                        <button
                          class="nav-link"
                          id="settings-tab"
                          data-bs-toggle="tab"
                          data-bs-target="#settings"
                          type="button"
                          role="tab"
                          aria-selected="false"
                        >
                          Configuración
                        </button>
                      </li>
                    </ul>
                  </div>
                  <div class="card-body">
                    <div class="tab-content">
                      <!-- Actividad tab -->
                      <div
                        class="tab-pane fade show active"
                        id="activity"
                        role="tabpanel"
                        aria-labelledby="activity-tab"
                      >
                        <article class="d-flex gap-3 mb-4">
                          <div
                            class="flex-shrink-0 rounded-circle bg-success-subtle text-success d-flex align-items-center justify-content-center"
                            style="width: 40px; height: 40px;"
                            aria-hidden="true"
                          >
                            JD
                          </div>
                          <div class="flex-grow-1">
                            <div class="d-flex justify-content-between">
                              <h4 class="h6 mb-0">Jane Doe</h4>
                              <small class="text-secondary">hace 2 horas</small>
                            </div>
                            <p class="mb-2">
                              Compartió <a href="#">design-system v2.4</a>, con una paleta de colores renovada y nuevas animaciones.
                            </p>
                            <a href="#" class="btn btn-sm btn-outline-secondary">
                              <i
                                class="bi bi-hand-thumbs-up me-1"
                                aria-hidden="true"
                              ></i>
                              Me gusta
                            </a>
                            <a
                              href="#"
                              class="btn btn-sm btn-outline-secondary ms-1"
                            >
                              <i
                                class="bi bi-chat me-1"
                                aria-hidden="true"
                              ></i>
                              Comentar
                            </a>
                          </div>
                        </article>
                        <article class="d-flex gap-3 mb-4">
                          <div
                            class="flex-shrink-0 rounded-circle bg-info-subtle text-info d-flex align-items-center justify-content-center"
                            style="width: 40px; height: 40px;"
                            aria-hidden="true"
                          >
                            JD
                          </div>
                          <div class="flex-grow-1">
                            <div class="d-flex justify-content-between">
                              <h4 class="h6 mb-0">Jane Doe</h4>
                              <small class="text-secondary">Ayer</small>
                            </div>
                            <p class="mb-2">
                              Publicó una pregunta en <a href="#">#design-help</a>: ¿cómo deberíamos tratar los anillos de foco en botones CTA de tema oscuro?
                            </p>
                          </div>
                        </article>
                        <article class="d-flex gap-3">
                          <div
                            class="flex-shrink-0 rounded-circle bg-warning-subtle text-warning d-flex align-items-center justify-content-center"
                            style="width: 40px; height: 40px;"
                            aria-hidden="true"
                          >
                            JD
                          </div>
                          <div class="flex-grow-1">
                            <div class="d-flex justify-content-between">
                              <h4 class="h6 mb-0">Jane Doe</h4>
                              <small class="text-secondary">hace 3 días</small>
                            </div>
                            <p class="mb-0">
                              Actualizó su biografía y agregó <em>investigación</em> a sus habilidades.
                            </p>
                          </div>
                        </article>
                      </div>

                      <!-- Cronología tab -->
                      <div
                        class="tab-pane fade"
                        id="timeline"
                        role="tabpanel"
                        aria-labelledby="timeline-tab"
                      >
                        <ul class="list-unstyled mb-0">
                          <li class="d-flex gap-3 mb-3">
                            <span
                              class="badge text-bg-success rounded-pill flex-shrink-0 align-self-start mt-1"
                            >
                              <i class="bi bi-check-lg" aria-hidden="true"></i>
                            </span>
                            <div>
                              <p class="mb-0 fw-semibold">
                                Publicó la versión 2.4 del sistema de diseño
                              </p>
                              <small class="text-secondary">May 16, 2026</small>
                            </div>
                          </li>
                          <li class="d-flex gap-3 mb-3">
                            <span
                              class="badge text-bg-info rounded-pill flex-shrink-0 align-self-start mt-1"
                            >
                              <i class="bi bi-mic" aria-hidden="true"></i>
                            </span>
                            <div>
                              <p class="mb-0 fw-semibold">
                                Participó como ponente en el encuentro local de UX
                              </p>
                              <small class="text-secondary">April 22, 2026</small>
                            </div>
                          </li>
                          <li class="d-flex gap-3">
                            <span
                              class="badge text-bg-warning rounded-pill flex-shrink-0 align-self-start mt-1"
                            >
                              <i class="bi bi-briefcase" aria-hidden="true"></i>
                            </span>
                            <div>
                              <p class="mb-0 fw-semibold">
                                Se unió al equipo de producto como diseñador sénior
                              </p>
                              <small class="text-secondary">March 1, 2026</small>
                            </div>
                          </li>
                        </ul>
                      </div>

                      <!-- Configuración tab -->
                      <div
                        class="tab-pane fade"
                        id="settings"
                        role="tabpanel"
                        aria-labelledby="settings-tab"
                      >
                        <form class="row g-3">
                          <div class="col-md-6">
                            <label class="form-label" for="profile-first">
                              Nombre
                            </label>
                            <input
                              type="text"
                              class="form-control"
                              id="profile-first"
                              value="Jane"
                            />
                          </div>
                          <div class="col-md-6">
                            <label class="form-label" for="profile-last">
                              Apellido
                            </label>
                            <input
                              type="text"
                              class="form-control"
                              id="profile-last"
                              value="Doe"
                            />
                          </div>
                          <div class="col-md-6">
                            <label class="form-label" for="profile-email">
                              Correo electrónico
                            </label>
                            <input
                              type="email"
                              class="form-control"
                              id="profile-email"
                              value="jane@example.com"
                            />
                          </div>
                          <div class="col-md-6">
                            <label class="form-label" for="profile-role">
                              Rol
                            </label>
                            <input
                              type="text"
                              class="form-control"
                              id="profile-role"
                              value="Diseñador de producto"
                            />
                          </div>
                          <div class="col-12">
                            <label class="form-label" for="profile-bio">Bio</label>
                            <textarea
                              class="form-control"
                              id="profile-bio"
                              rows="4">Diseñador con interés especial en los tokens de diseño y la accesibilidad.</textarea>
                          </div>
                          <div class="col-12">
                            <button type="submit" class="btn btn-primary">
                              Guardar cambios
                            </button>
                            <button type="reset" class="btn btn-outline-secondary ms-1">
                              Cancelar
                            </button>
                          </div>
                        </form>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </main>
      <Footer />
    </div>
    <Scripts path={path} />
  </body>
</html>
