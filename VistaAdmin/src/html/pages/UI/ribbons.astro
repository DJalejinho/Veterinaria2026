---
import Head from "@components/_head.astro"
import Footer from "@components/dashboard/_footer.astro"
import Topbar from "@components/dashboard/_topbar.astro"
import Sidenav from "@components/dashboard/_sidenav.astro"
import Scripts from "@components/_scripts.astro"

const title = "AdminLTE 4 | Cintas"
const path = "../../../dist"
const mainPage = "ui-elements"
const page = "ribbons"
const pageTitle = "Cintas"

// The corner banner takes its colour from a Bootstrap `.text-bg-*` utility.
// Etiquetas are short on purpose: only about 64px of the band is visible at the
// default size, so a long word is cut by the corner rather than ellipsised.
const variants = [
  { name: "primary", label: "Nuevo" },
  { name: "secondary", label: "Draft" },
  { name: "success", label: "Live" },
  { name: "danger", label: "Hot" },
  { name: "warning", label: "Beta" },
  { name: "info", label: "Tip" },
  { name: "dark", label: "Pro" }
]
---

<!doctype html>
<html lang="es">
  <!--begin::Head-->
  <head>
    <Head title={title} path={path} />
  </head>
  <!--end::Head-->
  <!--begin::Cuerpo-->
  <body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <!--begin::App Wrapper-->
    <div class="app-wrapper">
      <Topbar path={path} />
      <Sidenav path={path} mainPage={mainPage} page={page} />
      <!--begin::App Main-->
      <main class="app-main">
        <!--begin::App Content Header-->
        <div class="app-content-header">
          <!--begin::Container-->
          <div class="container-fluid">
            <!--begin::Row-->
            <div class="row">
              <div class="col-sm-6">
                <h1 class="mb-0 fs-3">{pageTitle}</h1>
              </div>
              <div class="col-sm-6">
                <nav aria-label="breadcrumb">
                  <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="#">Inicio</a></li>
                    <li class="breadcrumb-item active" aria-current="page">
                      {pageTitle}
                    </li>
                  </ol>
                </nav>
              </div>
            </div>
            <!--end::Row-->
          </div>
          <!--end::Container-->
        </div>
        <!--end::App Content Header-->
        <!--begin::App Content-->
        <div class="app-content">
          <!--begin::Container-->
          <div class="container-fluid">
            <div class="callout callout-info mb-4">
              <p>
                La cinta se fija a la esquina superior del elemento posicionado más cercano. Las tarjetas ya están posicionadas, así que puedes usar <code>.ribbon-wrapper</code> directamente dentro de una. Para cualquier otro elemento, agrega <code>.position-relative</code> al contenedor.
              </p>
              <p class="mb-0">
                Usa etiquetas cortas. La cinta se recorta en la esquina, por lo que en su tamaño predeterminado solo se leen unos <code>64px</code>, aproximadamente seis caracteres. Para textos más largos, usa <code>.ribbon-lg</code> o <code>.ribbon-xl</code>.
              </p>
            </div>

            <!--begin::Colores-->
            <h5 class="mb-3">Colores</h5>
            <!--begin::Row-->
            <div class="row g-4">
              {
                variants.map(variant => (
                  <div class="col-md-4 col-sm-6">
                    <div class="card mb-0">
                      <div class="ribbon-wrapper">
                        <div class={`ribbon text-bg-${variant.name}`}>
                          {variant.label}
                        </div>
                      </div>
                      <div class="card-body" style="min-height: 5rem;">
                        <h6 class="card-title text-capitalize mb-0">
                          {variant.name}
                        </h6>
                      </div>
                      <div class="card-footer">
                        <code class="text-body-emphasis">
                          .ribbon.text-bg-{variant.name}
                        </code>
                      </div>
                    </div>
                  </div>
                ))
              }
            </div>
            <!--end::Row-->
            <!--end::Colores-->

            <!--begin::Sizes-->
            <h5 class="mb-3 mt-4">Tamaños</h5>
            <!--begin::Row-->
            <div class="row g-4">
              <div class="col-lg-4">
                <div class="card mb-0">
                  <div class="ribbon-wrapper">
                    <div class="ribbon text-bg-primary">Predeterminado</div>
                  </div>
                  <div class="card-body" style="min-height: 9rem;">
                    <h6 class="card-title mb-0">Predeterminado</h6>
                  </div>
                  <div class="card-footer">
                    <code class="text-body-emphasis">.ribbon-wrapper</code>
                  </div>
                </div>
              </div>
              <div class="col-lg-4">
                <div class="card mb-0">
                  <div class="ribbon-wrapper ribbon-lg">
                    <div class="ribbon text-bg-success">Grande</div>
                  </div>
                  <div class="card-body" style="min-height: 9rem;">
                    <h6 class="card-title mb-0">Grande</h6>
                  </div>
                  <div class="card-footer">
                    <code class="text-body-emphasis">.ribbon-wrapper.ribbon-lg</code>
                  </div>
                </div>
              </div>
              <div class="col-lg-4">
                <div class="card mb-0">
                  <div class="ribbon-wrapper ribbon-xl">
                    <div class="ribbon text-bg-danger">Extra grande</div>
                  </div>
                  <div class="card-body" style="min-height: 9rem;">
                    <h6 class="card-title mb-0">Extra grande</h6>
                  </div>
                  <div class="card-footer">
                    <code class="text-body-emphasis">.ribbon-wrapper.ribbon-xl</code>
                  </div>
                </div>
              </div>
            </div>
            <!--end::Row-->
            <!--end::Sizes-->

            <!--begin::Fuera de una tarjeta-->
            <h5 class="mb-3 mt-4">Fuera de una tarjeta</h5>
            <!--begin::Row-->
            <div class="row g-4">
              <div class="col-lg-6">
                <div
                  class="position-relative overflow-hidden rounded border bg-body p-4"
                  style="min-height: 10rem;"
                >
                  <div class="ribbon-wrapper">
                    <div class="ribbon text-bg-warning">Nuevo</div>
                  </div>
                  <h6>Cualquier elemento posicionado</h6>
                  <p class="mb-0">
                    El contenedor solo necesita un elemento ancestro con
                    <code>position: relative</code>. Add
                    <code>.overflow-hidden</code> as well when the parent is
                    rounded, so the banner is clipped to the corner radius.
                  </p>
                </div>
              </div>
              <div class="col-lg-6">
                <div class="card mb-0">
                  <div class="ribbon-wrapper ribbon-lg">
                    <div class="ribbon text-bg-info">
                      <a href="#">Linked</a>
                    </div>
                  </div>
                  <div class="card-body" style="min-height: 10rem;">
                    <h6>Cinta interactiva</h6>
                    <p class="mb-0 pe-4">
                      A ribbon can wrap a link. It inherits whatever contrast
                      colour the utility picked, so the label stays readable in
                      both colour modes.
                    </p>
                  </div>
                </div>
              </div>
            </div>
            <!--end::Row-->
            <!--end::Fuera de una tarjeta-->
          </div>
          <!--end::Container-->
        </div>
        <!--end::App Content-->
      </main>
      <!--end::App Main-->
      <Footer />
    </div>
    <!--end::App Wrapper-->
    <!--begin::Script-->
    <Scripts path={path} />
    <!--end::Script-->
  </body><!--end::Cuerpo-->
</html>
