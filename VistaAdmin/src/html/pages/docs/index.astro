---
// Redirect from /docs/ (or /docs/index.html) to the Instalación page.
//
// Astro with build.format="file" builds this to dist/docs.html. The
// `flatten-build` npm script moves it to dist/docs/index.html so the
// redirect serves at /docs/ on the deployed site.
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>AdminLTE 4 — Documentación</title>
    <meta name="robots" content="noindex,follow" />
    <meta http-equiv="refresh" content="0; URL=./introduction.html" />
    <link rel="canonical" href="./introduction.html" />
  </head>
  <body>
    <p>
      Si la redirección no funciona, por favor
      <a href="./introduction.html">haz clic aquí para ver la documentación de AdminLTE 4</a>.
    </p>
  </body>
</html>
