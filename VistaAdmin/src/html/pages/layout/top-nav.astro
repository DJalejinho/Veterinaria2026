---
import Head from "@components/_head.astro"
import Footer from "@components/dashboard/_footer.astro"
import Scripts from "@components/_scripts.astro"

const title = "AdminLTE 4 | Diseño con navegación superior"
const path = "../../../dist"
const htmlPath = "..";

// Smart path resolution: calculate relative path based on directory depth
const pathname = Astro.url.pathname;
const pathSegments = pathname.split('/').filter(segment => segment !== '');
const depth = pathSegments.length > 0 ? pathSegments.length - 1 : 0;
const deploymentPath = depth === 0 ? './' : '../'.repeat(depth);
---

<!DOCTYPE html>
<html lang="es">
  <!--begin::Head-->
  <head>
    <Head title={title} path={path} />
  </head>
  <!--end::Head-->
  <!--
    Top-nav layout: there is NO <aside class="app-sidebar"> on this page, so the
    app-wrapper grid's sidebar column (grid-template-columns: auto 1fr) collapses
    to zero width on its own — header, main, and footer span the full viewport.
    La navegación principal está en el app-header como un componente estándar de Bootstrap
    navbar-expand-lg (Collapse + toggler on mobile). No Menú lateral, and therefore
    no sidebar-expand-* class on <body>.
  -->
  <!--begin::Cuerpo-->
  <body class="bg-body-tertiary">
    <!--begin::App Wrapper-->
    <div class="app-wrapper">
      <!--begin::Header-->
      <nav class="app-header navbar navbar-expand-lg bg-body">
        <!--begin::Container-->
        <div class="container-fluid">
          <!--begin::Brand-->
          <a href={htmlPath + "/index.html"} class="navbar-brand d-flex align-items-center">
            <img
              src={deploymentPath + "assets/img/AdminLTELogo.png"}
              alt="AdminLTE Logo"
              width="30"
              height="30"
              class="opacity-75 shadow me-2"
            />
            <span class="fw-light">AdminLTE 4</span>
          </a>
          <!--end::Brand-->
          <!--begin::Toggler (plain Bootstrap collapse, not Menú lateral)-->
          <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#topNavMenu"
            aria-controls="topNavMenu"
            aria-expanded="false"
            aria-label="Toggle navigation"
          >
            <span class="navbar-toggler-icon"></span>
          </button>
          <!--end::Toggler-->
          <!--begin::Collapsible Menu-->
          <div class="collapse navbar-collapse" id="topNavMenu">
            <ul class="navbar-nav">
              <li class="nav-item">
                <a class="nav-link active" aria-current="page" href="#">Inicio</a>
              </li>
              <li class="nav-item">
                <a class="nav-link" href={htmlPath + "/starter.html"}>Inicial</a>
              </li>
              <li class="nav-item dropdown">
                <a
                  class="nav-link dropdown-toggle"
                  href="#"
                  role="button"
                  data-bs-toggle="dropdown"
                  aria-expanded="false"
                >Pages</a>
                <ul class="dropdown-menu">
                  <li>
                    <a class="dropdown-item" href={htmlPath + "/pages/profile.html"}>Perfil</a>
                  </li>
                  <li>
                    <a class="dropdown-item" href={htmlPath + "/pages/invoice.html"}>Factura</a>
                  </li>
                  <li>
                    <a class="dropdown-item" href={htmlPath + "/pages/calendar.html"}>Calendario</a>
                  </li>
                  <li><hr class="dropdown-divider" /></li>
                  <li>
                    <a class="dropdown-item" href={htmlPath + "/pages/faq.html"}>Preguntas frecuentes</a>
                  </li>
                </ul>
              </li>
              <li class="nav-item dropdown">
                <a
                  class="nav-link dropdown-toggle"
                  href="#"
                  role="button"
                  data-bs-toggle="dropdown"
                  aria-expanded="false"
                >Formularios</a>
                <ul class="dropdown-menu">
                  <li>
                    <a class="dropdown-item" href={htmlPath + "/forms/elements.html"}>Elementos</a>
                  </li>
                  <li>
                    <a class="dropdown-item" href={htmlPath + "/forms/advanced.html"}>Elementos avanzados</a>
                  </li>
                  <li>
                    <a class="dropdown-item" href={htmlPath + "/forms/editors.html"}>Editores</a>
                  </li>
                  <li>
                    <a class="dropdown-item" href={htmlPath + "/forms/validation.html"}>Validación</a>
                  </li>
                </ul>
              </li>
            </ul>
            <ul class="navbar-nav ms-auto">
              <li class="nav-item">
                <a class="nav-link" href={htmlPath + "/docs/introduction.html"}>
                  <i class="bi bi-book me-1" aria-hidden="true"></i>
                  Documentation
                </a>
              </li>
            </ul>
          </div>
          <!--end::Collapsible Menu-->
        </div>
        <!--end::Container-->
      </nav>
      <!--end::Header-->
      <!--begin::App Main-->
      <main class="app-main">
        <!--begin::App Content Header-->
        <div class="app-content-header">
          <!--begin::Container-->
          <div class="container-fluid">
            <!--begin::Row-->
            <div class="row">
              <div class="col-sm-6">
                <h1 class="mb-0 fs-3">Diseño con navegación superior</h1>
              </div>
              <div class="col-sm-6">
                <nav aria-label="breadcrumb">
                  <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="#">Inicio</a></li>
                    <li class="breadcrumb-item"><a href="#">Diseño</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Navegación superior</li>
                  </ol>
                </nav>
              </div>
            </div>
            <!--end::Row-->
          </div>
          <!--end::Container-->
        </div>
        <!--end::App Content Header-->
        <!--begin::App Content-->
        <div class="app-content">
          <!--begin::Container-->
          <div class="container-fluid">
            <div class="row g-4">
              <div class="col-12">
                <div class="callout callout-info">
                  Diseño horizontal para aplicaciones con pocas secciones principales: no hay barra lateral y la navegación principal pasa al encabezado. Reduce la ventana por debajo del punto de interrupción <code>lg</code> para ver cómo el menú se oculta tras el botón de alternancia.
                </div>
              </div>

              <div class="col-md-6">
                <div class="card card-primary card-outline mb-4">
                  <div class="card-header">
                    <div class="card-title">Cómo funciona este diseño</div>
                  </div>
                  <div class="card-body">
                    <p>
                      Hay tres diferencias pequeñas con las páginas de demostración predeterminadas; no hace falta agregar CSS ni clases de diseño:
                    </p>
                    <ul class="mb-0">
                      <li class="mb-2">
                        Se omite el elemento <code>&lt;aside class="app-sidebar"&gt;</code>. La cuadrícula de <code>app-wrapper</code> dimensiona automáticamente la columna lateral; al estar vacía, su ancho pasa a cero y el contenido ocupa toda la ventana.
                      </li>
                      <li class="mb-2">
                        El encabezado conserva la clase <code>app-header</code>, pero se convierte en una barra de navegación Bootstrap <code>navbar-expand-lg</code>, con botón de alternancia y menú <code>.navbar-collapse</code>. No se utiliza el complemento Menú lateral de AdminLTE.
                      </li>
                      <li>
                        Se quita la clase <code>sidebar-expand-*</code> de <code>&lt;body&gt;</code>, porque no hay una barra lateral que expandir.
                      </li>
                    </ul>
                  </div>
                </div>
              </div>

              <div class="col-md-6">
                <div class="card card-success card-outline mb-4">
                  <div class="card-header">
                    <div class="card-title">Todo lo demás sigue igual</div>
                  </div>
                  <div class="card-body">
                    <p>
                      Las tarjetas, el encabezado del contenido, las migas de pan, el pie de página y los modos de color claro y oscuro se comportan igual que en las páginas con barra lateral. Esta tarjeta usa el marcado original de AdminLTE.
                    </p>
                    <p class="mb-2">Generación de informes mensuales</p>
                    <div
                      class="progress mb-3"
                      role="progressbar"
                      aria-label="Generación de informes mensuales"
                      aria-valuenow="72"
                      aria-valuemin="0"
                      aria-valuemax="100"
                    >
                      <div class="progress-bar" style="width: 72%">72%</div>
                    </div>
                    <p class="mb-2">Almacenamiento utilizado</p>
                    <div
                      class="progress mb-3"
                      role="progressbar"
                      aria-label="Almacenamiento utilizado"
                      aria-valuenow="45"
                      aria-valuemin="0"
                      aria-valuemax="100"
                    >
                      <div class="progress-bar text-bg-success" style="width: 45%">45%</div>
                    </div>
                    <a href={htmlPath + "/index.html"} class="btn btn-primary">
                      Volver al diseño con barra lateral
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <!--end::Container-->
        </div>
        <!--end::App Content-->
      </main>
      <!--end::App Main-->
      <Footer />
    </div>
    <!--end::App Wrapper-->
    <!--begin::Script-->
    <Scripts path={path} />
    <!--end::Script-->
  </body><!--end::Cuerpo-->
</html>
