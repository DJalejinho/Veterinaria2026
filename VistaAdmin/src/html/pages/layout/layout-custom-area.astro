---
import Head from "@components/_head.astro"
import Footer from "@components/dashboard/_footer.astro"
import Topbar from "@components/dashboard/_topbar.astro"
import Sidenav from "@components/dashboard/_sidenav.astro"
import Scripts from "@components/_scripts.astro"

const title = "AdminLTE 4 | Área personalizada del diseño"
const path = "../../../dist"
const mainPage = "layout"
const page = "layout-custom-area";
---

<!DOCTYPE html>
<html lang="es">
<!--begin::Head-->
<head>
  <Head title={title} path={path}/>
</head>
<!--end::Head-->
<!--begin::Cuerpo-->
<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
<!--begin::App Wrapper-->
<div class="app-wrapper">
  <Topbar path={path}/>
  <Sidenav path={path} mainPage={mainPage} page={page}/>

    <!--begin::App Main-->
    <main class="app-main">
      <!--begin::Área superior del contenido de la aplicación-->
      <div class="app-content-top-area">
        <!--begin::Container-->
        <div class="container-fluid">
          <div class="row">
            <div class="col-md-6">
              <div>Área superior del contenido de la aplicación</div>
            </div>

            <div class="col-md-6 text-end">
              <button type="submit" class="btn btn-primary" name="save" value="create">Crear administrador</button>
            </div>
          </div>
        </div>
        <!--end::Container-->
      </div>
      <!--end::Área inferior del contenido de la aplicación-->
      <!--begin::App Content Header-->
      <div class="app-content-header">
        <!--begin::Container-->
        <div class="container-fluid">
          <!--begin::Row-->
          <div class="row">
            <div class="col-sm-8">
              <h1 class="mb-0 fs-3"> Área personalizada del diseño </h1>
            </div>
            <div class="col-sm-4">
              <nav aria-label="breadcrumb">
                <ol class="breadcrumb float-sm-end">
                  <li class="breadcrumb-item"><a href="#">Inicio</a></li>
                  <li class="breadcrumb-item active" aria-current="page">
                    Diseño fijo
                  </li>
                </ol>
              </nav>
            </div>
          </div>
          <!--end::Row-->
        </div>
        <!--end::Container-->
      </div>
      <!--end::App Content Header-->
      <!--begin::App Content-->
      <div class="app-content">
        <!--begin::Container-->
        <div class="container-fluid">
          <!--begin::Row-->
          <div class="row">
            <div class="col-12">
              <!-- Default box -->
              <div class="card">
                <div class="card-header">
                  <h3 class="card-title">Título</h3>

                  <div class="card-tools">
                    <button
                      type="button"
                      class="btn btn-tool"
                      data-lte-toggle="card-collapse"
                      aria-label="Plegar tarjeta"
                      title="Collapse"
                    >
                      <i data-lte-icon="expand" class="bi bi-plus-lg"></i>
                      <i data-lte-icon="collapse" class="bi bi-dash-lg"></i>
                    </button>
                    <button
                      type="button"
                      class="btn btn-tool"
                      data-lte-toggle="card-remove"
                      aria-label="Quitar tarjeta"
                      title="Remove"
                    >
                      <i class="bi bi-x-lg"></i>
                    </button>
                  </div>
                </div>
                <div class="card-body">
                  ¡Empieza a crear tu increíble aplicación!
                </div>
                <!-- /.card-body -->
                <div class="card-footer">Pie de página</div>
                <!-- /.card-footer-->
              </div>
              <!-- /.card -->
            </div>
          </div>
          <!--end::Row-->
        </div>
        <!--end::Container-->
      </div>
      <!--end::App Content-->

      <!--begin::Área inferior del contenido de la aplicación-->
      <div class="app-content-bottom-area">
         <!--begin::Container-->
         <div class="container-fluid">
           <div class="row">
             <div class="col-md-6">
               <div>Área inferior del contenido de la aplicación</div>
             </div>

             <div class="col-md-6 text-end">
               <button type="submit" class="btn btn-secondary" name="save" value="create">Actualizar</button>
             </div>
           </div>
         </div>
        <!--end::Container-->
      </div>
      <!--end::Área inferior del contenido de la aplicación-->
    </main>
    <!--end::App Main-->
    <Footer />
</div>
<!--end::App Wrapper-->
<!--begin::Script-->
<Scripts path={path}/>
<!--end::Script-->
</body><!--end::Cuerpo-->
</html>
