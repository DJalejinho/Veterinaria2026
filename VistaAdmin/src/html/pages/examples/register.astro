---
import Head from "@components/_head.astro"
import Scripts from "@components/_scripts.astro"

const title = "AdminLTE 4 | Registrarse Page"
const path = "../../../dist"
const htmlPath = "..";
---

<!DOCTYPE html>
<html lang="es">
  <!--begin::Head-->
  <head>
    <Head title={title} path={path} />
  </head>
  <!--end::Head-->
  <!--begin::Cuerpo-->
  <body class="register-page bg-body-secondary">
    <main class="register-box">
      <h1 class="register-logo">
        <a href={htmlPath + "/index2.html"}><b>Admin</b>LTE</a>
      </h1>
      <!-- /.register-logo -->
      <div class="card">
        <div class="card-body register-card-body">
          <p class="register-box-msg">Regístrate para crear una cuenta</p>

          <form action={htmlPath + "/index3.html"} method="post">
            <label class="visually-hidden" for="registerName">Nombre completo</label>
            <div class="input-group mb-3">
              <input
                id="registerName"
                type="text"
                class="form-control"
                placeholder="Nombre completo"
              />
              <div class="input-group-text">
                <span class="bi bi-person"></span>
              </div>
            </div>
            <label class="visually-hidden" for="registerEmail">Correo electrónico</label>
            <div class="input-group mb-3">
              <input
                id="registerEmail"
                type="email"
                class="form-control"
                placeholder="Correo electrónico"
              />
              <div class="input-group-text">
                <span class="bi bi-envelope"></span>
              </div>
            </div>
            <label class="visually-hidden" for="registerPassword">Contraseña</label>
            <div class="input-group mb-3">
              <input
                id="registerPassword"
                type="password"
                class="form-control"
                placeholder="Contraseña"
              />
              <div class="input-group-text">
                <span class="bi bi-lock-fill"></span>
              </div>
            </div>
            <!--begin::Row-->
            <div class="row">
              <div class="col-8">
                <div class="form-check">
                  <input
                    class="form-check-input"
                    type="checkbox"
                    value=""
                    id="flexCheckDefault"
                  />
                  <label class="form-check-label" for="flexCheckDefault">
                    Acepto los <a href="#">terms</a>
                  </label>
                </div>
              </div>
              <!-- /.col -->
              <div class="col-4">
                <div class="d-grid gap-2">
                  <button type="submit" class="btn btn-primary">Registrarse</button>
                </div>
              </div>
              <!-- /.col -->
            </div>
            <!--end::Row-->
          </form>

          <div class="social-auth-links text-center mb-3 d-grid gap-2">
            <p>- OR -</p>
            <a href="#" class="btn btn-primary">
              <i class="bi bi-facebook me-2"></i> Crear cuenta con Facebook
            </a>
            <a href="#" class="btn btn-danger">
              <i class="bi bi-google me-2"></i> Crear cuenta con Google
            </a>
          </div>
          <!-- /.social-auth-links -->

          <p class="mb-0">
            <a href="login.html" class="text-center">
              I already have a membership
            </a>
          </p>
        </div>
        <!-- /.register-card-body -->
      </div>
    </main>
    <!-- /.register-box -->

    <Scripts path={path} />
    <!--end::Script-->
  </body><!--end::Cuerpo-->
</html>
