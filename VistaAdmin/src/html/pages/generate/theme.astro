                              {set.label}
                            </button>
                          ))
                        }
                      </div>
                      <span class="text-body-secondary small">
                        <span data-palette-set="designed">Catorce colores diseñados para una relación de 4,5:1; todos admiten texto blanco.</span>
                        <span data-palette-set="v3" hidden>Los dieciocho colores de AdminLTE 3, sin cambiar sus valores y con la regla de color de texto de la v3.</span>
                      </span>
                    </div>
                    <div class="form-check form-switch mb-3">
