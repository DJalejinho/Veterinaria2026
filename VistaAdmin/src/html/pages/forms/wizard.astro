---
import Head from "@components/_head.astro"
import Footer from "@components/dashboard/_footer.astro"
import Topbar from "@components/dashboard/_topbar.astro"
import Sidenav from "@components/dashboard/_sidenav.astro"
import Scripts from "@components/_scripts.astro"

const title = "AdminLTE 4 | Asistente de formularios"
const path = "../../../dist"
const mainPage = "forms"
const page = "wizard";
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <Head title={title} path={path} />
    <style is:inline>
      .wizard-steps {
        counter-reset: step;
        list-style: none;
        padding: 0;
        display: flex;
        justify-content: space-between;
        position: relative;
      }
      .wizard-steps::before {
        content: "";
        position: absolute;
        top: 1rem;
        left: 0;
        right: 0;
        height: 2px;
        background: var(--bs-border-color);
        z-index: 0;
      }
      .wizard-steps li {
        position: relative;
        z-index: 1;
        background: var(--bs-body-bg);
        padding: 0 .75rem;
        text-align: center;
        color: var(--bs-secondary-color);
        font-size: .875rem;
      }
      .wizard-steps li::before {
        counter-increment: step;
        content: counter(step);
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        margin: 0 auto .5rem;
        border-radius: 50%;
        background: var(--bs-body-tertiary-bg);
        border: 2px solid var(--bs-border-color);
        color: var(--bs-secondary-color);
        font-weight: 600;
      }
      .wizard-steps li.active {
        color: var(--bs-primary);
        font-weight: 600;
      }
      .wizard-steps li.active::before {
        background: var(--bs-primary);
        border-color: var(--bs-primary);
        color: #fff;
      }
      .wizard-steps li.completed::before {
        background: var(--bs-success);
        border-color: var(--bs-success);
        color: #fff;
        content: "\f633";
        font-family: "bootstrap-icons";
      }
    </style>
  </head>
  <body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <div class="app-wrapper">
      <Topbar path={path} />
      <Sidenav path={path} mainPage={mainPage} page={page} />
      <main class="app-main">
        <div class="app-content-header">
          <div class="container-fluid">
            <div class="row">
              <div class="col-sm-6">
                <h1 class="mb-0 fs-3">Asistente de formularios</h1>
              </div>
              <div class="col-sm-6">
                <nav aria-label="breadcrumb">
                  <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="#">Inicio</a></li>
                    <li class="breadcrumb-item"><a href="#">Formularios</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Asistente</li>
                  </ol>
                </nav>
              </div>
            </div>
          </div>
        </div>
        <div class="app-content">
          <div class="container-fluid">
            <div class="row justify-content-center">
              <div class="col-lg-10 col-xl-8">
                <div class="card">
                  <div class="card-body p-4">
                    <!-- Step indicators -->
                    <ol class="wizard-steps mb-4" id="wizard-steps">
                      <li class="active" data-step="0">Cuenta</li>
                      <li data-step="1">Perfil</li>
                      <li data-step="2">Preferencias</li>
                      <li data-step="3">Revisión</li>
                    </ol>

                    <!-- Form -->
                    <form id="wizard-form" novalidate>
                      <!-- Step 1 -->
                      <fieldset class="wizard-step" data-step="0">
                        <h2 class="h5 mb-3">Crea tu cuenta</h2>
                        <div class="row g-3">
                          <div class="col-md-6">
                            <label class="form-label" for="wz-email">Correo electrónico</label>
                            <input
                              type="email"
                              class="form-control"
                              id="wz-email"
                              required
                            />
                            <div class="invalid-feedback">
                              Ingresa un correo electrónico válido.
                            </div>
                          </div>
                          <div class="col-md-6">
                            <label class="form-label" for="wz-username">
                              Nombre de usuario
                            </label>
                            <input
                              type="text"
                              class="form-control"
                              id="wz-username"
                              required
                              minlength="3"
                            />
                            <div class="invalid-feedback">
                              El nombre de usuario debe tener al menos 3 caracteres.
                            </div>
                          </div>
                          <div class="col-md-6">
                            <label class="form-label" for="wz-password">
                              Contraseña
                            </label>
                            <input
                              type="password"
                              class="form-control"
                              id="wz-password"
                              required
                              minlength="8"
                            />
                            <div class="invalid-feedback">
                              La contraseña debe tener al menos 8 caracteres.
                            </div>
                          </div>
                          <div class="col-md-6">
                            <label class="form-label" for="wz-password2">
                              Confirmar contraseña
                            </label>
                            <input
                              type="password"
                              class="form-control"
                              id="wz-password2"
                              required
                            />
                            <div class="invalid-feedback">
                              Las contraseñas deben coincidir.
                            </div>
                          </div>
                        </div>
                      </fieldset>

                      <!-- Step 2 -->
                      <fieldset class="wizard-step d-none" data-step="1">
                        <h2 class="h5 mb-3">Cuéntanos sobre ti</h2>
                        <div class="row g-3">
                          <div class="col-md-6">
                            <label class="form-label" for="wz-first">
                              Nombre
                            </label>
                            <input
                              type="text"
                              class="form-control"
                              id="wz-first"
                              required
                            />
                            <div class="invalid-feedback">
                              El nombre es obligatorio.
                            </div>
                          </div>
                          <div class="col-md-6">
                            <label class="form-label" for="wz-last">
                              Apellido
                            </label>
                            <input
                              type="text"
                              class="form-control"
                              id="wz-last"
                              required
                            />
                            <div class="invalid-feedback">
                              El apellido es obligatorio.
                            </div>
                          </div>
                          <div class="col-md-6">
                            <label class="form-label" for="wz-company">
                              Empresa
                            </label>
                            <input
                              type="text"
                              class="form-control"
                              id="wz-company"
                            />
                          </div>
                          <div class="col-md-6">
                            <label class="form-label" for="wz-role">
                              Rol
                            </label>
                            <select class="form-select" id="wz-role" required>
                              <option value="">Elegir&hellip;</option>
                              <option>Fundador/a o director/a ejecutivo/a</option>
                              <option>Ingeniería</option>
                              <option>Diseño</option>
                              <option>Marketing</option>
                              <option>Otro</option>
                            </select>
                            <div class="invalid-feedback">
                              Selecciona un cargo.
                            </div>
                          </div>
                        </div>
                      </fieldset>

                      <!-- Step 3 -->
                      <fieldset class="wizard-step d-none" data-step="2">
                        <h2 class="h5 mb-3">Preferencias de notificación</h2>
                        <div class="form-check form-switch mb-2">
                          <input
                            class="form-check-input"
                            type="checkbox"
                            id="wz-notif-product"
                            role="switch"
                            checked
                          />
                          <label class="form-check-label" for="wz-notif-product">
                            Novedades y versiones del producto
                          </label>
                        </div>
                        <div class="form-check form-switch mb-2">
                          <input
                            class="form-check-input"
                            type="checkbox"
                            id="wz-notif-security"
                            role="switch"
                            checked
                          />
                          <label class="form-check-label" for="wz-notif-security">
                            Alertas de seguridad
                          </label>
                        </div>
                        <div class="form-check form-switch mb-3">
                          <input
                            class="form-check-input"
                            type="checkbox"
                            id="wz-notif-marketing"
                            role="switch"
                          />
                          <label class="form-check-label" for="wz-notif-marketing">
                            Marketing y consejos
                          </label>
                        </div>
                        <label class="form-label" for="wz-frequency">
                          Frecuencia del resumen
                        </label>
                        <select class="form-select" id="wz-frequency">
                          <option>En tiempo real</option>
                          <option selected>Diario</option>
                          <option>Semanal</option>
                          <option>Nunca</option>
                        </select>
                      </fieldset>

                      <!-- Step 4 -->
                      <fieldset class="wizard-step d-none" data-step="3">
                        <h2 class="h5 mb-3">Revisar y confirmar</h2>
                        <dl class="row mb-3" id="wz-summary"></dl>
                        <div class="form-check">
                          <input
                            class="form-check-input"
                            type="checkbox"
                            id="wz-terms"
                            required
                          />
                          <label class="form-check-label" for="wz-terms">
                            Acepto los <a href="#">términos del servicio</a>.
                          </label>
                          <div class="invalid-feedback">
                            Debes aceptar los términos para continuar.
                          </div>
                        </div>
                      </fieldset>

                      <!-- Navigation -->
                      <div class="d-flex justify-content-between mt-4">
                        <button
                          type="button"
                          class="btn btn-outline-secondary"
                          id="wz-prev"
                          disabled
                        >
                          <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>
                          Anterior
                        </button>
                        <button
                          type="button"
                          class="btn btn-primary"
                          id="wz-next"
                        >
                          Siguiente
                          <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
                        </button>
                        <button
                          type="submit"
                          class="btn btn-success d-none"
                          id="wz-submit"
                        >
                          <i class="bi bi-check-lg me-1" aria-hidden="true"></i>
                          Enviar
                        </button>
                      </div>
                    </form>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </main>
      <Footer />
    </div>
    <Scripts path={path} />
    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        const form = document.getElementById("wizard-form");
        const steps = form.querySelectorAll(".wizard-step");
        const indicators = document.querySelectorAll("#wizard-steps li");
        const prevBtn = document.getElementById("wz-prev");
        const nextBtn = document.getElementById("wz-next");
        const submitBtn = document.getElementById("wz-submit");
        let current = 0;

        const show = (i) => {
          steps.forEach((s, idx) => s.classList.toggle("d-none", idx !== i));
          indicators.forEach((li, idx) => {
            li.classList.toggle("active", idx === i);
            li.classList.toggle("completed", idx < i);
          });
          prevBtn.disabled = i === 0;
          const last = i === steps.length - 1;
          nextBtn.classList.toggle("d-none", last);
          submitBtn.classList.toggle("d-none", !last);
          if (last) renderSummary();
        };

        const validateStep = (i) => {
          const step = steps[i];
          const fields = step.querySelectorAll("input, select, textarea");
          let valid = true;
          fields.forEach((field) => {
            field.classList.remove("is-invalid");
            if (!field.checkValidity()) {
              field.classList.add("is-invalid");
              valid = false;
            }
          });
          // Comprueba que las contraseñas coincidan en el paso 0
          if (i === 0) {
            const p1 = document.getElementById("wz-password");
            const p2 = document.getElementById("wz-password2");
            if (p1.value !== p2.value) {
              p2.classList.add("is-invalid");
              valid = false;
            }
          }
          return valid;
        };

        const renderSummary = () => {
          const summary = document.getElementById("wz-summary");
          const get = (id) => document.getElementById(id);
          const rows = [
            ["Correo electrónico", get("wz-email").value],
            ["Nombre de usuario", get("wz-username").value],
            ["Nombre", `${get("wz-first").value} ${get("wz-last").value}`],
            ["Empresa", get("wz-company").value || "—"],
            ["Rol", get("wz-role").value || "—"],
            ["Digest", get("wz-frequency").value]
          ];
          summary.innerHTML = rows
            .map(
              ([k, v]) =>
                `<dt class="col-sm-4 text-secondary fw-normal">${k}</dt><dd class="col-sm-8 fw-semibold">${v}</dd>`
            )
            .join("");
        };

        nextBtn.addEventListener("click", () => {
          if (!validateStep(current)) return;
          if (current < steps.length - 1) {
            current++;
            show(current);
          }
        });

        prevBtn.addEventListener("click", () => {
          if (current > 0) {
            current--;
            show(current);
          }
        });

        form.addEventListener("submit", (e) => {
          e.preventDefault();
          if (!validateStep(current)) return;
          alert("¡Asistente completado! El formulario se enviaría aquí.");
        });

        show(0);
      });
    </script>
  </body>
</html>
