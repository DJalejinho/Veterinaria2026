---
import Head from "@components/_head.astro"
import Footer from "@components/dashboard/_footer.astro"
import Topbar from "@components/dashboard/_topbar.astro"
import Sidenav from "@components/dashboard/_sidenav.astro"
import Scripts from "@components/_scripts.astro"

const title = "AdminLTE 4 | Buzón - Read"
const path = "../../../dist"
const htmlPath = ".."
const mainPage = "mailbox"
const page = "read";
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <Head title={title} path={path} />
  </head>
  <body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <div class="app-wrapper">
      <Topbar path={path} />
      <Sidenav path={path} mainPage={mainPage} page={page} />
      <main class="app-main">
        <div class="app-content-header">
          <div class="container-fluid">
            <div class="row">
              <div class="col-sm-6">
                <h1 class="mb-0 fs-3">Leer mensaje</h1>
              </div>
              <div class="col-sm-6">
                <nav aria-label="breadcrumb">
                  <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="#">Inicio</a></li>
                    <li class="breadcrumb-item">
                      <a href={htmlPath + "/mailbox/inbox.html"}>Buzón</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Read</li>
                  </ol>
                </nav>
              </div>
            </div>
          </div>
        </div>
        <div class="app-content">
          <div class="container-fluid">
            <div class="card">
              <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title">Re: design system v2.4 sign-off</h3>
                <div class="btn-group btn-group-sm">
                  <a
                    href={htmlPath + "/mailbox/inbox.html"}
                    class="btn btn-outline-secondary"
                    title="Volver a la bandeja de entrada"
                  >
                    <i class="bi bi-arrow-left" aria-hidden="true"></i>
                  </a>
                  <button
                    class="btn btn-outline-secondary"
                    type="button"
                    title="Anterior"
                  >
                    <i class="bi bi-chevron-up" aria-hidden="true"></i>
                  </button>
                  <button
                    class="btn btn-outline-secondary"
                    type="button"
                    title="Siguiente"
                  >
                    <i class="bi bi-chevron-down" aria-hidden="true"></i>
                  </button>
                </div>
              </div>
              <div class="card-body">
                <!-- Enviarer meta -->
                <div class="d-flex gap-3 align-items-start mb-4">
                  <div
                    class="flex-shrink-0 rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center"
                    style="width: 48px; height: 48px;"
                    aria-hidden="true"
                  >
                    OB
                  </div>
                  <div class="flex-grow-1">
                    <div class="d-flex justify-content-between">
                      <div>
                        <p class="mb-0 fw-semibold">Olivia Bennett</p>
                        <small class="text-secondary">
                          olivia@example.com &mdash; to me
                        </small>
                      </div>
                      <small class="text-secondary">10:42 &middot; hace 2 horas</small>
                    </div>
                  </div>
                </div>

                <!-- Cuerpo -->
                <div class="mb-4">
                  <p>Hola, Jane,</p>
                  <p>
                    Revisé esta mañana la versión candidata 2.4. En general, se ve muy bien y está lista para publicarse, con dos observaciones:
                  </p>
                  <ol>
                    <li>
                      El estado correcto de los campos del formulario tiene poco contraste sobre
                      <code>bg-body-tertiary</code>. Can we bump the border
                      contrast by ~10%?
                    </li>
                    <li>
                      El nuevo indicador de foco se ve muy bien en el tema claro, pero casi no
                      se distingue en el oscuro. Conviene revisar la accesibilidad antes de publicar la
                      versión.
                    </li>
                  </ol>
                  <p>
                    Por lo demás, estoy totalmente de acuerdo. A los clientes les van a encantar las animaciones.
                  </p>
                  <p class="mb-0">
                    Olivia<br />
                    <small class="text-secondary">Enviado desde mi portátil</small>
                  </p>
                </div>

                <!-- Archivos adjuntos -->
                <h6 class="fw-semibold">Archivos adjuntos (2)</h6>
                <div class="row g-2 mb-3">
                  <div class="col-md-6">
                    <div class="card">
                      <div class="card-body py-2 px-3 d-flex align-items-center gap-2">
                        <i
                          class="bi bi-file-earmark-pdf-fill text-danger fs-3"
                          aria-hidden="true"
                        ></i>
                        <div class="flex-grow-1">
                          <p class="mb-0 small fw-semibold">design-review.pdf</p>
                          <small class="text-secondary">1.4 MB</small>
                        </div>
                        <a href="#" class="btn btn-sm btn-outline-secondary">
                          <i class="bi bi-download" aria-hidden="true"></i>
                        </a>
                      </div>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="card">
                      <div class="card-body py-2 px-3 d-flex align-items-center gap-2">
                        <i
                          class="bi bi-file-earmark-image-fill text-primary fs-3"
                          aria-hidden="true"
                        ></i>
                        <div class="flex-grow-1">
                          <p class="mb-0 small fw-semibold">focus-ring-dark.png</p>
                          <small class="text-secondary">320 KB</small>
                        </div>
                        <a href="#" class="btn btn-sm btn-outline-secondary">
                          <i class="bi bi-download" aria-hidden="true"></i>
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="card-footer d-flex gap-2">
                <a
                  href={htmlPath + "/mailbox/compose.html"}
                  class="btn btn-primary"
                >
                  <i class="bi bi-reply me-1" aria-hidden="true"></i>Responder
                </a>
                <button class="btn btn-outline-secondary" type="button">
                  <i class="bi bi-arrow-90deg-right me-1" aria-hidden="true"></i>
                  Reenviar
                </button>
                <button class="btn btn-outline-secondary ms-auto" type="button">
                  <i class="bi bi-archive me-1" aria-hidden="true"></i>Archive
                </button>
                <button class="btn btn-outline-danger" type="button">
                  <i class="bi bi-trash me-1" aria-hidden="true"></i>Eliminar
                </button>
              </div>
            </div>
          </div>
        </div>
      </main>
      <Footer />
    </div>
    <Scripts path={path} />
  </body>
</html>
